<!DOCTYPE html>
<html lang="sw">
<head>
  <meta charset="UTF-8">
  <title>Smart Kids Game</title>
  <style>
    body {
      font-family: Comic Sans MS, Arial, sans-serif;
      background: linear-gradient(to right, #ffe082, #b3e5fc);
      text-align: center;
      padding: 20px;
    }
    h1 {
      color: #e65100;
    }
    .card {
      background: white;
      border-radius: 20px;
      padding: 20px;
      max-width: 400px;
      margin: auto;
      box-shadow: 0 0 12px #999;
    }
    button {
      padding: 12px 18px;
      margin: 6px;
      border-radius: 12px;
      border: none;
      font-size: 16px;
      background: #ff9800;
      color: white;
      cursor: pointer;
    }
    button:hover {
      background: #f57c00;
    }
    #answer {
      margin-top: 12px;
      font-size: 18px;
      font-weight: bold;
    }
    #score {
      margin-top: 10px;
      font-size: 16px;
      color: #2e7d32;
    }
  </style>
</head>
<body>

  <h1>🎮 Smart Kids Game</h1>

  <div class="card">
    <p id="question">Bonyeza Start 🚀</p>
    <div id="choices"></div>
    <button onclick="startGame()">Start</button>
    <p id="answer"></p>
    <p id="score">Alama: 0</p>
  </div>

  <script>
    let score = 0;
    let level = "easy";

    function speak(text) {
      let msg = new SpeechSynthesisUtterance(text);
      msg.lang = "sw-TZ";
      speechSynthesis.speak(msg);
    }

    function startGame() {
      askQuestion();
    }

    function askQuestion() {
      let x = Math.floor(Math.random() * 5) + 1;
      let y = Math.floor(Math.random() * 5) + 1;

      if (level === "hard") {
        x = Math.floor(Math.random() * 10) + 1;
        y = Math.floor(Math.random() * 10) + 1;
      }

      let correct = x + y;
      document.getElementById("question").innerHTML = "🧮 " + x + " + " + y + " = ?";

      let options = [];
      options.push(correct);
      options.push(correct + 1);
      options.push(correct - 1);
      options.push(correct + 2);

      options.sort(() => Math.random() - 0.5);

      let html = "";
      options.forEach(num => {
        html += `<button onclick="checkAnswer(${num}, ${correct})">${num}</button>`;
      });

      document.getElementById("choices").innerHTML = html;
      speak("Hesabu " + x + " kuongeza " + y);
    }

    function checkAnswer(chosen, correct) {
      if (chosen === correct) {
        score++;
        document.getElementById("answer").innerHTML = "✅ Sahihi!";
        speak("Hongera! Jibu sahihi");
      } else {
        document.getElementById("answer").innerHTML = "❌ Sio sahihi. Jibu ni " + correct;
        speak("Jaribu tena. Jibu sahihi ni " + correct);
      }
      document.getElementById("score").innerHTML = "Alama: " + score;
      setTimeout(askQuestion, 1500);
    }
  </script>

</body>
</html>
